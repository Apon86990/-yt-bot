import os
from pyrogram import Client, filters
import yt_dlp

API_ID = 20400000 
API_HASH = "your_api_hash" 
BOT_TOKEN = "8650717469:AAGo-3dcnKFWchyW7D3qkI36xwQfWxLmUNs"

app = Client(
    "youtube_downloader_bot",
    api_id=API_ID,
    api_hash=API_HASH,
    bot_token=BOT_TOKEN
)

@app.on_message(filters.regex("^(http|https)://(www\.)?(youtube\.|youtu\.be/)"))
async def download_youtube(client, message):
    url = message.text
    status_msg = await message.reply_text("📥 Video download hochhe...")
    
    ydl_opts = {
        'format': 'bestvideo[height<=1080]+bestaudio/best[height<=1080]',
        'outtmpl': '%(title)s.%(ext)s',
    }
    
    try:
        with yt-dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            filename = ydl.prepare_filename(info)
            
        await message.reply_video(video=filename, caption="✅ Apnar video ready!")
        os.remove(filename)
        await status_msg.delete()
    except Exception as e:
        await status_msg.edit_text(f"❌ Bhul hoyeche: {str(e)}")

@app.on_message(filters.text & ~filters.regex("^(http|https)"))
async def search_and_download_music(client, message):
    query = message.text
    status_msg = await message.reply_text(f"🔍 '{query}' khunje ber korchi...")
    
    ydl_opts = {
        'format': 'bestaudio/best',
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '192',
        }],
        'outtmpl': 'song.%(ext)s',
        'default_search': 'ytsearch1',
    }
    
    try:
        with yt-dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.extract_info(query, download=True)
            filename = "song.mp3"
            
        await message.reply_audio(audio=filename, title=query, performer="YouTube Music Bot")
        os.remove(filename)
        await status_msg.delete()
    except Exception as e:
        await status_msg.edit_text(f"❌ Gaan khunje paoa jayni: {str(e)}")

app.run()
